---
const eventDate = new Date('2026-11-06T19:00:00-05:00');
const phone = '573246683878';
const whatsappMessage = encodeURIComponent('Hola, confirmo mi asistencia a los XV años de Sara Valentina.');
const calendarUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent('XV años de Sara Valentina') + '&dates=20261106T190000/20261107T020000&details=' + encodeURIComponent('Celebración de los XV años de Sara Valentina Motta Álvarez') + '&location=' + encodeURIComponent('Lugar por confirmar');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="Invitación a los XV años de Sara Valentina Motta Álvarez · 6 de noviembre de 2026." />
    <title>XV · Sara Valentina</title>
  </head>
  <body>
    <main>
      <section class="hero" id="inicio">
        <div class="hero-frame" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="overline">Una noche para recordar</p>
          <p class="roman">XV</p>
          <h1>Sara<br /><em>Valentina</em></h1>
          <div class="hero-rule"><span>✦</span></div>
          <p class="hero-date">06 · NOVIEMBRE · 2026</p>
          <a class="enter" href="#invitacion">Descubrir la invitación <span>↓</span></a>
        </div>
      </section>

      <section class="invitation section" id="invitacion">
        <p class="overline blush">Con cariño</p>
        <h2>Hay momentos<br />que merecen<br /><em>celebrarse.</em></h2>
        <div class="ornament">❧ <span>✦</span> ❧</div>
        <p class="message">Mis XV años son el comienzo de una nueva etapa y quiero compartir esta noche tan especial con las personas que hacen mi vida más bonita.</p>
        <p class="message">Será una alegría contar contigo para celebrar, brindar y guardar juntos un recuerdo para siempre.</p>
        <p class="signature">Con amor,<br /><strong>Sara Valentina</strong></p>
      </section>

      <section class="details section">
        <p class="overline blush">La celebración</p>
        <h2>Guarda la fecha</h2>
        <div class="date-card">
          <div class="date-side"><span>Viernes</span><strong>06</strong><span>Noviembre</span></div>
          <div class="date-side"><span>Recepción</span><strong>7:00</strong><span>de la noche</span></div>
        </div>
        <div class="countdown" data-countdown data-target={eventDate.toISOString()} aria-label="Cuenta regresiva">
          <div><b data-days>00</b><span>días</span></div><i>:</i><div><b data-hours>00</b><span>horas</span></div><i>:</i><div><b data-minutes>00</b><span>minutos</span></div><i>:</i><div><b data-seconds>00</b><span>segundos</span></div>
        </div>
        <a class="outline-button" href={calendarUrl} target="_blank" rel="noreferrer">Agregar al calendario <span>↗</span></a>
      </section>

      <section class="dress section">
        <div class="place-card"><span class="place-symbol">✦</span><p class="overline blush">Recepción</p><strong>Lugar<br /><em>por definir</em></strong><small>Pronto compartiremos todos los detalles.</small></div>
        <div class="dress-copy">
          <p class="overline blush">Código de vestuario</p>
          <h2>Una noche<br /><em>en tonos joya.</em></h2>
          <p>Te invito a vestir de negro, oro rosa o dorado para crear juntos una noche llena de elegancia y luz.</p>
          <div class="swatches" aria-label="Colores sugeridos"><span class="black"></span><span class="rose"></span><span class="gold"></span></div>
          <div class="gift"><span>✦</span><div><b>Lluvia de sobres</b><small>Tu presencia es mi mejor regalo.</small></div></div>
        </div>
      </section>

      <section class="rsvp section">
        <p class="overline">Será un honor</p>
        <h2>¿Nos<br /><em>acompañas?</em></h2>
        <p>Confirma tu asistencia para compartir contigo esta noche inolvidable.</p>
        <a class="primary-button" href={`https://wa.me/${phone}?text=${whatsappMessage}`} target="_blank" rel="noreferrer">Confirmar asistencia <span>↗</span></a>
        <p class="contact">324 668 3878</p>
      </section>

      <footer><span>✦</span><p>Sara Valentina Motta Álvarez · XV</p><span>✦</span></footer>
    </main>
    <button class="top" type="button" aria-label="Volver al inicio" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>
    <script is:inline>
      const countdown = document.querySelector('[data-countdown]');
      const tick = () => { const diff = Math.max(0, new Date(countdown.dataset.target).getTime() - Date.now()); const values = [Math.floor(diff/86400000), Math.floor(diff/3600000)%24, Math.floor(diff/60000)%60, Math.floor(diff/1000)%60]; ['days','hours','minutes','seconds'].forEach((key,i) => document.querySelector(`[data-${key}]`).textContent = String(values[i]).padStart(2,'0')); };
      tick(); setInterval(tick, 1000);
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@400;500;600&family=Italianno&display=swap');
  :root{--ink:#090909;--paper:#f6f0ed;--rose:#c9888e;--rose-light:#e6b9b6;--gold:#d7b474;--muted:#b9aaa6;--serif:'Cormorant Garamond',Georgia,serif;--script:'Italianno',cursive;--sans:'DM Sans',Arial,sans-serif}
  *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--ink);color:var(--paper);font-family:var(--sans)} a{color:inherit;text-decoration:none} .section{padding:clamp(5rem,13vw,10rem) max(1.5rem,8vw);position:relative;overflow:hidden}.hero{min-height:100svh;position:relative;display:grid;place-items:center;padding:3rem 1.5rem;background:radial-gradient(circle at 70% 25%,#2a1818 0,#090909 45%);isolation:isolate}.hero-frame{position:absolute;inset:1rem;border:1px solid rgba(215,180,116,.65);z-index:-1}.hero-frame:before,.hero-frame:after{content:'✦';position:absolute;color:var(--gold);font-size:1rem;background:var(--ink);padding:.3rem}.hero-frame:before{top:-.8rem;left:50%;transform:translateX(-50%)}.hero-frame:after{bottom:-.8rem;left:50%;transform:translateX(-50%)}.hero-copy{text-align:center;z-index:1;transform:translateY(-2rem)}.overline{font:500 .68rem/1 var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--gold)}.roman{font:500 clamp(4.5rem,14vw,8rem)/.75 var(--serif);color:var(--rose-light);margin:1.5rem 0 1.3rem}.hero h1{font:500 clamp(3.8rem,12vw,7rem)/.78 var(--serif);letter-spacing:-.04em;margin:0}.hero h1 em,.invitation h2 em,.dress h2 em,.rsvp h2 em{font-style:italic;color:var(--rose-light)}.hero-rule{display:flex;align-items:center;gap:.8rem;justify-content:center;color:var(--gold);margin:2.2rem 0 1.4rem}.hero-rule:before,.hero-rule:after{content:'';width:3.4rem;height:1px;background:var(--gold)}.hero-date{font-size:.7rem;letter-spacing:.28em;color:var(--muted);margin:0}.enter{display:inline-flex;flex-direction:column;gap:.75rem;margin-top:3.5rem;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--rose-light)}.enter span{font-size:1.4rem;color:var(--gold)}.hero-photo{position:absolute;right:7%;bottom:6%;width:clamp(7rem,18vw,12rem);height:clamp(9.5rem,26vw,16rem);border:1px solid var(--gold);padding:.35rem;transform:rotate(5deg);opacity:.8}.hero-photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.65) contrast(1.05)}.invitation{text-align:center;background:var(--paper);color:var(--ink);min-height:80vh}.blush{color:#a8666d}.invitation h2,.details h2,.dress h2,.rsvp h2{font:500 clamp(3rem,8vw,5.8rem)/.82 var(--serif);letter-spacing:-.04em;margin:1.7rem 0 2.5rem}.ornament{color:#b27676;letter-spacing:.7rem;font-size:1.3rem}.ornament span{color:var(--gold);font-size:.9rem}.message{max-width:35rem;margin:1.3rem auto;color:#5d4d4d;font:400 1.08rem/1.6 var(--serif)}.signature{font:400 1.35rem/1.2 var(--serif);color:#8c5a60;margin-top:2.8rem}.signature strong{font:400 2.2rem var(--script);color:#9f626a}.details{text-align:center;background:#111;color:var(--paper);background-image:linear-gradient(120deg,rgba(201,136,142,.08),transparent 45%)}.details h2{margin-bottom:3.5rem}.date-card{max-width:34rem;margin:auto;border-top:1px solid var(--gold);border-bottom:1px solid var(--gold);display:grid;grid-template-columns:1fr 1fr;padding:2.3rem 0}.date-side{display:flex;flex-direction:column;gap:.45rem;align-items:center}.date-side+ .date-side{border-left:1px solid #594543}.date-side span{font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}.date-side strong{font:500 clamp(3.5rem,10vw,6rem)/.8 var(--serif);color:var(--rose-light)}.countdown{display:flex;align-items:center;justify-content:center;gap:clamp(.55rem,2vw,1.4rem);margin:3rem 0}.countdown div{display:flex;flex-direction:column;gap:.35rem;min-width:3.3rem}.countdown b{font:500 2rem var(--serif);color:var(--gold)}.countdown span{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.countdown i{font-style:normal;color:var(--rose);font-size:1.5rem;margin-top:-1rem}.outline-button,.primary-button{display:inline-flex;gap:1.2rem;align-items:center;border:1px solid var(--gold);padding:.9rem 1.3rem;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;transition:.25s}.outline-button:hover,.primary-button:hover{background:var(--gold);color:var(--ink)}.dress{display:grid;grid-template-columns:minmax(13rem,25rem) 1fr;gap:clamp(2.5rem,9vw,8rem);align-items:center;background:var(--paper);color:var(--ink)}.dress-art{height:30rem;border:1px solid var(--gold);padding:.4rem;overflow:hidden;transform:rotate(-3deg)}.dress-art img{width:100%;height:100%;object-fit:cover;filter:sepia(.25) saturate(.65) hue-rotate(300deg) brightness(.65)}.dress-copy h2{font-size:clamp(3.1rem,7vw,5.3rem);margin-bottom:1.5rem}.dress-copy>p:not(.overline){font:1.2rem/1.5 var(--serif);color:#625354;max-width:28rem}.swatches{display:flex;gap:.8rem;margin:2rem 0}.swatches span{width:1.6rem;height:1.6rem;border-radius:50%;border:1px solid #9c8580}.swatches .black{background:#0a0a0a}.swatches .rose{background:#c9888e}.swatches .gold{background:#d7b474}.gift{display:flex;gap:1rem;align-items:center;border-top:1px solid #d7c5c0;padding-top:1.3rem;max-width:28rem}.gift>span{color:#af7178;font-size:1.8rem}.gift div{display:flex;flex-direction:column;gap:.2rem}.gift b{font:600 .8rem var(--sans);letter-spacing:.1em;text-transform:uppercase}.gift small{color:#7a6968}.rsvp{text-align:center;background:linear-gradient(145deg,#1d1112,#090909);min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center}.rsvp h2{margin-bottom:1.5rem}.rsvp>p:not(.overline):not(.contact){font:1.2rem/1.4 var(--serif);color:var(--muted);max-width:27rem;margin:0 0 2rem}.primary-button{background:var(--rose);border-color:var(--rose);color:var(--ink);font-weight:600}.contact{font-size:.75rem;letter-spacing:.18em;color:var(--gold);margin-top:1.5rem}footer{display:flex;justify-content:center;gap:1.2rem;align-items:center;padding:2rem 1rem;color:var(--muted);font-size:.65rem;letter-spacing:.12em;text-align:center}footer span{color:var(--gold)}.top{position:fixed;bottom:1rem;right:1rem;width:2.5rem;height:2.5rem;border:1px solid var(--gold);border-radius:50%;background:#111d;color:var(--gold);z-index:4;cursor:pointer;font-size:1.1rem}@media(max-width:700px){.hero-photo{right:7%;bottom:5%;width:5.7rem;height:8rem}.dress{grid-template-columns:1fr}.dress-art{height:18rem;max-width:15rem;margin:auto}.dress-copy{text-align:center}.dress-copy .overline{margin-top:1rem}.swatches,.gift{justify-content:center}.gift{text-align:left}.section{padding-left:1.5rem;padding-right:1.5rem}.date-card{max-width:22rem}.date-side strong{font-size:4rem}.countdown{gap:.35rem}.countdown div{min-width:2.6rem}.countdown b{font-size:1.6rem}.countdown span{font-size:.52rem}}
  /* Tarjetas: composición vertical inspirada en las referencias impresas. */
  body{background:#050505;background-image:radial-gradient(circle at 15% 10%,rgba(201,136,142,.1),transparent 28%),radial-gradient(circle at 85% 80%,rgba(215,180,116,.08),transparent 25%)}
  main{padding:1rem 0 2rem}
  .hero,.section{width:min(100% - 2rem, 42rem);margin:1rem auto;border:1px solid rgba(215,180,116,.45);border-radius:1.25rem;box-shadow:0 1.5rem 4rem rgba(0,0,0,.32)}
  .hero{min-height:min(92svh, 54rem);border-color:rgba(215,180,116,.72)}
  .hero-frame{inset:1rem;border-radius:.75rem}
  .section{min-height:0}
  .invitation{min-height:38rem}
  .details{min-height:34rem}
  .dress{min-height:34rem}
  .rsvp{min-height:32rem}
  footer{padding-bottom:3rem}
  @media(max-width:700px){main{padding-top:.25rem}.hero,.section{width:calc(100% - 1rem);margin:.5rem auto;border-radius:.9rem}.hero{min-height:calc(100svh - 1rem)}.hero-frame{inset:.7rem}.invitation,.details,.dress,.rsvp{min-height:0}.invitation{padding-top:5.5rem;padding-bottom:5.5rem}.details{padding-top:4.5rem;padding-bottom:4.5rem}.dress{padding-top:4.5rem;padding-bottom:4.5rem}.rsvp{padding-top:5rem;padding-bottom:5rem}}
  .place-card{height:30rem;border:1px solid var(--gold);background:linear-gradient(145deg,#171011,#0b0b0b);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:1.1rem;transform:rotate(-3deg);padding:2rem}.place-symbol{font-size:2.4rem;color:var(--gold)}.place-card .overline{margin:0}.place-card strong{font:500 clamp(2.8rem,6vw,4.5rem)/.82 var(--serif);color:var(--paper)}.place-card strong em{font-style:italic;color:var(--rose-light)}.place-card small{max-width:13rem;color:var(--muted);font:1rem/1.35 var(--serif)}
  @media(max-width:700px){.place-card{height:18rem;max-width:15rem;margin:auto}}
</style>
